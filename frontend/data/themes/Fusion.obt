@OBSThemeMeta {
  name: "Waluigi";
  id: "Fusion.Waluigi";
  author: "SoftPrawn";
}
@OBSThemeVars {
  --fontSizeLarge: calc(1.2pt * var(--obsFontScale));
  --fontSizeNormal: calc(1pt * var(--obsFontScale));
  --fontSizeSmall: calc(0.85pt * var(--obsFontScale));
  --fontSizeSmaller: calc(0.75pt * var(--obsFontScale));
  --fontSizeSmallest: calc(0.65pt * var(--obsFontScale));
}

  padding: 4px;
}
OBSBasic #controlsFrame QPushButton:on {
  background: rgb(61.2, 61.2, 61.2);
}
OBSBasic #controlsFrame QPushButton:hover {
  background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 rgb(217.1419161677, 75.8688622754, 1.3080838323), stop: 0.5 #A63A01);
}
OBSBasic #controlsFrame QPushButton:pressed {
  background: rgba(166, 58, 1, 216);
}
OBSBasic #controlsFrame QPushButton:disabled {
  background: transparent;
}
OBSBasic #controlsFrame QPushButton {
  margin: 1px;
}
OBSBasic #controlsFrame QPushButton:!hover:!pressed.state-active {

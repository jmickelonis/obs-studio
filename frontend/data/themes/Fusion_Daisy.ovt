.mixer-category {
  color: #f8f8f8;
  border: 1px solid rgb(35.7, 35.7, 35.7);
  border-radius: 3px;
  font-size: var(--fontSizeSmallest);
  font-weight: bold;
  background: #162A64;
}

.volume-hidden .mixer-category {

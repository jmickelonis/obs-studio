@OBSThemeMeta {
  name: "Daisy";
  id: "Fusion.Daisy";
  extends: "Fusion";
  author: "SoftPrawn";
  dark: "true";
}
@OBSThemeVars {
  --palette_alternateBase: #000000;
  --palette_base: #141414;
  --palette_brightText: #FFFFFF;
  --palette_dark: #141414;
  --palette_highlight: #A63A01;
  --palette_highlightedText: #FFFFFF;
  --palette_light: #3D3D3D;
  --palette_link: #B35827;
  --palette_linkVisited: #B35827;
  --palette_mid: #292929;
  --palette_midlight: #333333;
  --palette_shadow: #000000;
  --palette_text: #F8F8F8;
  --palette_window: #292929;
  --palette_windowText: #F8F8F8;
}
.icon-clear {
  qproperty-icon: url(theme:Fusion/entry-clear.svg);
  qproperty-iconSize: 14px 14px;
}

.icon-close {
  qproperty-icon: url(theme:Fusion/close.svg);
  qproperty-iconSize: 14px 14px;
}

.icon-cogs {
  qproperty-icon: url(theme:Fusion/cogs.svg);
  qproperty-iconSize: 14px 14px;
}

.icon-dots-vert {
  qproperty-icon: url(theme:Fusion/dots-vert.svg);
  qproperty-iconSize: 14px 14px;
}

.icon-down {
  qproperty-icon: url(theme:Fusion/down.svg);
  qproperty-iconSize: 14px 14px;
}

.icon-filter {
  qproperty-icon: url(theme:Fusion/filter.svg);
  qproperty-iconSize: 14px 14px;
}

.icon-gear {
  qproperty-icon: url(theme:Fusion/settings/general.svg);
  qproperty-iconSize: 14px 14px;
}

.icon-layout-horizontal {
  qproperty-icon: url(theme:Fusion/layout-horizontal.svg);
  qproperty-iconSize: 14px 14px;
}

.icon-layout-vertical {
  qproperty-icon: url(theme:Fusion/layout-vertical.svg);
  qproperty-iconSize: 14px 14px;
}

.icon-minus {
  qproperty-icon: url(theme:Fusion/minus.svg);
  qproperty-iconSize: 14px 14px;
}

.icon-pause {
  qproperty-icon: url(theme:Fusion/media-pause.svg);
  qproperty-iconSize: 14px 14px;
}

.icon-plus {
  qproperty-icon: url(theme:Fusion/plus.svg);
  qproperty-iconSize: 14px 14px;
}

.icon-refresh {
  qproperty-icon: url(theme:Fusion/refresh.svg);
  qproperty-iconSize: 14px 14px;
}

.icon-revert {
  qproperty-icon: url(theme:Fusion/revert.svg);
  qproperty-iconSize: 14px 14px;
}

.icon-save {
  qproperty-icon: url(theme:Fusion/save.svg);
  qproperty-iconSize: 14px 14px;
}

.icon-touch {
  qproperty-icon: url(theme:Fusion/interact.svg);
  qproperty-iconSize: 14px 14px;
}

.icon-trash {
  qproperty-icon: url(theme:Fusion/trash.svg);
  qproperty-iconSize: 14px 14px;
}

.icon-up {
  qproperty-icon: url(theme:Fusion/up.svg);
  qproperty-iconSize: 14px 14px;
}

.icon-media-next {
  qproperty-icon: url(theme:Fusion/media/media_next.svg);
  qproperty-iconSize: 14px 14px;
}

.icon-media-pause {
  qproperty-icon: url(theme:Fusion/media/media_pause.svg);
  qproperty-iconSize: 14px 14px;
}

.icon-media-play {
  qproperty-icon: url(theme:Fusion/media/media_play.svg);
  qproperty-iconSize: 14px 14px;
}

.icon-media-prev {
  qproperty-icon: url(theme:Fusion/media/media_previous.svg);
  qproperty-iconSize: 14px 14px;
}

.icon-media-restart {
  qproperty-icon: url(theme:Fusion/media/media_restart.svg);
  qproperty-iconSize: 14px 14px;
}

.icon-media-stop {
  qproperty-icon: url(theme:Fusion/media/media_stop.svg);
  qproperty-iconSize: 14px 14px;
}

OBSBasic {
  qproperty-audioInputIcon: url(theme:Fusion/sources/microphone.svg);
  qproperty-audioOutputIcon: url(theme:Fusion/settings/audio.svg);
  qproperty-audioProcessOutputIcon: url(theme:Fusion/sources/windowaudio.svg);
  qproperty-browserIcon: url(theme:Fusion/sources/globe.svg);
  qproperty-cameraIcon: url(theme:Fusion/sources/camera.svg);
  qproperty-colorIcon: url(theme:Fusion/sources/brush.svg);
  qproperty-defaultIcon: url(theme:Fusion/sources/default.svg);
  qproperty-desktopCapIcon: url(theme:Fusion/settings/video.svg);
  qproperty-gameCapIcon: url(theme:Fusion/sources/gamepad.svg);
  qproperty-groupIcon: url(theme:Fusion/sources/group.svg);
  qproperty-imageIcon: url(theme:Fusion/sources/image.svg);
  qproperty-mediaIcon: url(theme:Fusion/sources/media.svg);
  qproperty-sceneIcon: url(theme:Fusion/sources/scene.svg);
  qproperty-slideshowIcon: url(theme:Fusion/sources/slideshow.svg);
  qproperty-textIcon: url(theme:Fusion/sources/text.svg);
  qproperty-windowCapIcon: url(theme:Fusion/sources/window.svg);
}

OBSBasicSettings {
  qproperty-accessibilityIcon: url(theme:Fusion/settings/accessibility.svg);
  qproperty-advancedIcon: url(theme:Fusion/settings/advanced.svg);
  qproperty-appearanceIcon: url(theme:Fusion/settings/appearance.svg);
  qproperty-audioIcon: url(theme:Fusion/settings/audio.svg);
  qproperty-generalIcon: url(theme:Fusion/settings/general.svg);
  qproperty-hotkeysIcon: url(theme:Fusion/settings/hotkeys.svg);
  qproperty-outputIcon: url(theme:Fusion/settings/output.svg);
  qproperty-streamIcon: url(theme:Fusion/settings/stream.svg);
  qproperty-videoIcon: url(theme:Fusion/settings/video.svg);
}

#contextContainer QPushButton#sourceFiltersButton {
  qproperty-icon: url(theme:Fusion/filter.svg);
  qproperty-iconSize: 14px 14px;
}
#contextContainer QPushButton#sourcePropertiesButton {
  qproperty-icon: url(theme:Fusion/settings/general.svg);
  qproperty-iconSize: 14px 14px;
}

QCheckBox::indicator,
QGroupBox::indicator,
QTableView::indicator {
  width: 16px;
  height: 16px;
  image: url(theme:Fusion/ui/checkbox/unchecked.svg);
}
QCheckBox::indicator:checked,
QGroupBox::indicator:checked,
QTableView::indicator:checked {
  image: url(theme:Fusion/ui/checkbox/checked.svg);
}
QCheckBox::indicator:hover:!pressed,
QGroupBox::indicator:hover:!pressed,
QTableView::indicator:hover:!pressed {
  image: url(theme:Fusion/ui/checkbox/hover.svg);
}
QCheckBox::indicator:hover:!pressed:checked,
QGroupBox::indicator:hover:!pressed:checked,
QTableView::indicator:hover:!pressed:checked {
  image: url(theme:Fusion/ui/checkbox/checked hover.svg);
}
QCheckBox::indicator:disabled,
QGroupBox::indicator:disabled,
QTableView::indicator:disabled {
  image: url(theme:Fusion/ui/checkbox/disabled.svg);
}
QCheckBox::indicator:disabled:checked,
QGroupBox::indicator:disabled:checked,
QTableView::indicator:disabled:checked {
  image: url(theme:Fusion/ui/checkbox/checked disabled.svg);
}

QRadioButton::indicator {
  width: 16px;
  height: 16px;
  image: url(theme:Fusion/ui/radio/unchecked.svg);
}
QRadioButton::indicator:checked {
  image: url(theme:Fusion/ui/radio/checked.svg);
}
QRadioButton::indicator:hover:!pressed {
  image: url(theme:Fusion/ui/radio/hover.svg);
}
QRadioButton::indicator:hover:!pressed:checked {
  image: url(theme:Fusion/ui/radio/checked hover.svg);
}
QRadioButton::indicator:disabled {
  image: url(theme:Fusion/ui/radio/disabled.svg);
}
QRadioButton::indicator:disabled:checked {
  image: url(theme:Fusion/ui/radio/checked disabled.svg);
}

QDockWidget {
  titlebar-close-icon: url(theme:Fusion/close.svg);
  titlebar-normal-icon: url(theme:Fusion/popout.svg);
}
QDockWidget::window {
  titlebar-normal-icon: url(theme:Fusion/collapse.svg);
}

QToolBar {
  qproperty-iconSize: 14px 14px;
}

.btn-mute {
  qproperty-icon: url(theme:Fusion/settings/audio.svg);
  qproperty-iconSize: 14px 14px;
}
.btn-mute.checked {
  qproperty-icon: url(theme:Fusion/mute.svg);
  qproperty-iconSize: 14px 14px;
}
.btn-mute.mute-unassigned {
  qproperty-icon: url(theme:Fusion/unassigned.svg);
  qproperty-iconSize: 14px 14px;
}

.btn-monitor {
  qproperty-icon: url(theme:Fusion/headphones-off.svg);
  qproperty-iconSize: 14px 14px;
}
.btn-monitor.checked {
  qproperty-icon: url(theme:Fusion/headphones.svg);
  qproperty-iconSize: 14px 14px;
}

.indicator-expand::indicator:checked, .indicator-expand::indicator:hover:checked, .indicator-expand::indicator:hover:!pressed:checked {
  image: url(theme:Fusion/expand.svg);
}
.indicator-expand::indicator:unchecked, .indicator-expand::indicator:hover:unchecked {
  image: url(theme:Fusion/collapse.svg);
}
.indicator-expand::indicator {
  width: 8px;
  height: 8px;
}

.indicator-lock::indicator:checked, .indicator-lock::indicator:hover:checked, .indicator-lock::indicator:hover:!pressed:checked {
  image: url(theme:Fusion/locked.svg);
}
.indicator-lock::indicator:unchecked, .indicator-lock::indicator:hover:unchecked {
  image: url(theme:Fusion/unlocked.svg);
}

.indicator-visibility::indicator:checked, .indicator-visibility::indicator:hover:checked, .indicator-visibility::indicator:hover:!pressed:checked {
  image: url(theme:Fusion/visible.svg);
}
.indicator-visibility::indicator:unchecked, .indicator-visibility::indicator:hover:unchecked {
  image: url(theme:Fusion/invisible.svg);
}

QWidget {
  color: #f8f8f8;
  font-size: var(--fontSizeNormal);
  selection-color: #ffffff;
  selection-background-color: rgb(83.5, 83.5, 83.5);
}
QWidget::active {
  selection-background-color: #A63A01;
}
QWidget::disabled {
  color: rgba(248, 248, 248, 127);
  selection-color: rgba(255, 255, 255, 127);
  selection-background-color: rgba(166, 58, 1, 127);
}

.text-title {
  font-size: var(--fontSizeLarge);
  font-weight: bold;
}

.text-warning {
  font-style: italic;
}

QAbstractItemView {
  background: transparent;
  outline: none;
}
QAbstractItemView::item {
  border-radius: 2px;
  min-height: 1.33em;
}
QAbstractItemView::item:focus {
  background: rgba(166, 58, 1, 63);
}
QAbstractItemView::item:selected {
  background: #A63A01;
}
QAbstractItemView::item:selected:!active:!hover {
  background: rgba(166, 58, 1, 127);
}
QAbstractItemView::item:hover {
  background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 rgb(217.1419161677, 75.8688622754, 1.3080838323), stop: 0.5 #A63A01);
}
QAbstractItemView QScrollBar {
  background: transparent;
}

QScrollBar {
  background: rgba(20.4, 20.4, 20.4, 0.5);
  border: none;
  border-radius: 3px;
}
QScrollBar:horizontal {
  height: 6px;
}
QScrollBar:vertical {
  width: 6px;
}
QScrollBar:disabled {
  background: rgba(20.4, 20.4, 20.4, 0.25);
}
QScrollBar::add-line, QScrollBar::sub-line {
  background: transparent;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
  width: 0;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
  height: 0;
}
QScrollBar::handle {
  background: #7c7c7c;
  border-radius: 3px;
  margin: 0px;
}
QScrollBar::handle:horizontal {
  min-width: 20px;
}
QScrollBar::handle:vertical {
  min-height: 20px;
}
QScrollBar::handle:hover {
  background: rgb(148.8, 148.8, 148.8);
}
QScrollBar::handle:disabled {
  background: rgba(124, 124, 124, 127);
}

QAbstractScrollArea {
  border: none;
}
QAbstractScrollArea::corner {
  background: transparent;
}

QPushButton::flat,
QPushButton[toolButton=true],
QTableView QPushButton,
QToolBar QPushButton,
QToolButton,
.btn-tool,
#contextContainer QPushButton {
  background: transparent;
  border: none;
  border-radius: 3px;
  padding: 4px;
}
QPushButton::flat:on,
QPushButton[toolButton=true]:on,
QTableView QPushButton:on,
QToolBar QPushButton:on,
QToolButton:on,
.btn-tool:on,
#contextContainer QPushButton:on {
  background: rgb(61.2, 61.2, 61.2);
}
QPushButton::flat:hover,
QPushButton[toolButton=true]:hover,
QTableView QPushButton:hover,
QToolBar QPushButton:hover,
QToolButton:hover,
.btn-tool:hover,
#contextContainer QPushButton:hover {
  background: rgb(71.4, 71.4, 71.4);
}
QPushButton::flat:pressed,
QPushButton[toolButton=true]:pressed,
QTableView QPushButton:pressed,
QToolBar QPushButton:pressed,
QToolButton:pressed,
.btn-tool:pressed,
#contextContainer QPushButton:pressed {
  background: rgb(61.2, 61.2, 61.2);
}
QPushButton::flat:disabled,
QPushButton[toolButton=true]:disabled,
QTableView QPushButton:disabled,
QToolBar QPushButton:disabled,
QToolButton:disabled,
.btn-tool:disabled,
#contextContainer QPushButton:disabled {
  background: transparent;
}

OBSHotkeyWidget QPushButton,
#centralwidget .icon-dots-vert,
#centralwidget .icon-plus {
  background: transparent;
  border: none;
  border-radius: 3px;
  padding: 4px;
}
OBSHotkeyWidget QPushButton:on,
#centralwidget .icon-dots-vert:on,
#centralwidget .icon-plus:on {
  background: rgb(61.2, 61.2, 61.2);
}
OBSHotkeyWidget QPushButton:hover,
#centralwidget .icon-dots-vert:hover,
#centralwidget .icon-plus:hover {
  background: rgb(71.4, 71.4, 71.4);
}
OBSHotkeyWidget QPushButton:pressed,
#centralwidget .icon-dots-vert:pressed,
#centralwidget .icon-plus:pressed {
  background: rgb(61.2, 61.2, 61.2);
}
OBSHotkeyWidget QPushButton:disabled,
#centralwidget .icon-dots-vert:disabled,
#centralwidget .icon-plus:disabled {
  background: transparent;
}
OBSHotkeyWidget QPushButton,
#centralwidget .icon-dots-vert,
#centralwidget .icon-plus {
  width: 14px;
  height: 14px;
}

.btn-monitor,
.btn-mute {
  background: transparent;
  border: none;
  border-radius: 3px;
  padding: 4px;
}
.btn-monitor:on,
.btn-mute:on {
  background: transparent;
}
.btn-monitor:hover,
.btn-mute:hover {
  background: rgb(71.4, 71.4, 71.4);
}
.btn-monitor:pressed,
.btn-mute:pressed {
  background: rgb(61.2, 61.2, 61.2);
}
.btn-monitor:disabled,
.btn-mute:disabled {
  background: transparent;
}

QPushButton {
  background: rgb(34.068, 34.068, 34.068);
}
QPushButton:disabled {
  background: rgba(34.068, 34.068, 34.068, 0.5);
}

QAbstractSpinBox,
QComboBox,
QLineEdit,
QPlainTextEdit,
QTextEdit {
  background: rgb(34.068, 34.068, 34.068);
}
QAbstractSpinBox:disabled,
QComboBox:disabled,
QLineEdit:disabled,
QPlainTextEdit:disabled,
QTextEdit:disabled {
  background: rgba(34.068, 34.068, 34.068, 0.5);
}
QAbstractSpinBox,
QComboBox,
QLineEdit,
QPlainTextEdit,
QTextEdit {
  border: 1px solid rgb(20.4, 20.4, 20.4);
  border-radius: 3px;
}
QAbstractSpinBox:!read-only:hover,
QComboBox:!read-only:hover,
QLineEdit:!read-only:hover,
QPlainTextEdit:!read-only:hover,
QTextEdit:!read-only:hover {
  background: rgb(27.336, 27.336, 27.336);
}
QAbstractSpinBox:!read-only:focus,
QComboBox:!read-only:focus,
QLineEdit:!read-only:focus,
QPlainTextEdit:!read-only:focus,
QTextEdit:!read-only:focus {
  background: black;
}
QAbstractSpinBox:disabled,
QComboBox:disabled,
QLineEdit:disabled,
QPlainTextEdit:disabled,
QTextEdit:disabled {
  border-color: rgba(20.4, 20.4, 20.4, 0.5);
}
QAbstractSpinBox:focus,
QComboBox:focus,
QLineEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus {
  border-color: #A63A01;
}

QLineEdit {
  padding: 2px 0;
}

QAbstractSpinBox {
  padding-bottom: 1px;
}
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
  border: none;
  width: 16px;
}
QAbstractSpinBox::up-button {
  padding-top: 3px;
}
QAbstractSpinBox::down-button {
  padding-bottom: 3px;
}
QAbstractSpinBox::up-arrow, QAbstractSpinBox::down-arrow {
  height: 8px;
}
QAbstractSpinBox::up-arrow:hover, QAbstractSpinBox::down-arrow:hover {
  height: 10px;
}
QAbstractSpinBox::up-arrow:!disabled {
  image: url(theme:Fusion/popout.svg);
}
QAbstractSpinBox::down-arrow:!disabled {
  image: url(theme:Fusion/collapse.svg);
}

QMenu QAbstractSpinBox {
  background: transparent;
  border-color: transparent;
}
QMenu QAbstractSpinBox:hover {
  border-color: #A63A01;
}
QMenu QAbstractSpinBox:!focus {
  background: transparent;
}
QMenu QAbstractSpinBox:!focus:hover:!read-only {
  background: transparent;
}

QComboBox {
  padding: 2px;
  combobox-popup: 0;
}
QComboBox:hover, QComboBox:on {
  background: rgb(27.336, 27.336, 27.336);
}
QComboBox::drop-down {
  border: none;
  width: 16px;
}
QComboBox::down-arrow {
  height: 8px;
}
QComboBox::down-arrow:editable:hover {
  height: 10px;
}
QComboBox::down-arrow:!disabled {
  image: url(theme:Fusion/collapse.svg);
}
QComboBox::down-arrow:!disabled:on {
  image: url(theme:Fusion/popout.svg);
}
QComboBox QAbstractItemView {
  background: rgb(27.336, 27.336, 27.336);
  border: 1px solid #A63A01;
}

QHeaderView::section {
  background: rgb(34.068, 34.068, 34.068);
  border: 1px solid rgb(20.4, 20.4, 20.4);
  font-weight: bold;
  padding: 0 3px;
}
QHeaderView::section:horizontal:first {
  border-top-left-radius: 3px;
}
QHeaderView::section:horizontal:last {
  border-top-right-radius: 3px;
}
QHeaderView::section:horizontal:!first {
  border-left: none;
}
QHeaderView::section:vertical:first {
  border-top-left-radius: 3px;
}
QHeaderView::section:vertical:last {
  border-bottom-left-radius: 3px;
}
QHeaderView::section:vertical:!first {
  border-top: none;
}

QTableView {
  gridline-color: transparent;
}
QTableView::item:focus {
  background: rgb(37.434, 37.434, 37.434);
}
QTableView::item:hover {
  background: rgb(34.068, 34.068, 34.068);
}
QTableView QLineEdit {
  background: black;
  border: none;
  border-radius: 2px;
}

QTabBar {
  background: transparent;
  border: none;
  font-size: var(--fontSizeNormal);
}
QTabBar::tab:top {
  position: absolute;
  border: 1px solid rgb(20.4, 20.4, 20.4);
  background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 rgb(34.068, 34.068, 34.068), stop: 1 rgb(34.068, 34.068, 34.068));
  padding: 3px 6px;
}
QTabBar::tab:top:hover {
  background: rgb(40.8, 40.8, 40.8);
}
QTabBar::tab:top:selected {
  background: rgb(40.8, 40.8, 40.8);
  border-bottom-color: rgb(40.8, 40.8, 40.8);
  margin-bottom: -1px;
}
QTabBar::tab:top {
  border-top-left-radius: 3px;
  border-top-right-radius: 3px;
  margin-left: -1px;
}
QTabBar::tab:top:first {
  margin-left: 5px;
}
QTabBar::tab:top:last {
  margin-right: 5px;
}
QTabBar::tab:top:!selected {
  top: 2px;
  padding-top: 2px;
  padding-bottom: 2px;
}
QTabBar::tab:bottom {
  position: absolute;
  border: 1px solid rgb(20.4, 20.4, 20.4);
  background: qlineargradient(x1: 0, y1: 1, x2: 0, y2: 0, stop: 0 rgb(34.068, 34.068, 34.068), stop: 1 rgb(34.068, 34.068, 34.068));
  padding: 3px 6px;
}
QTabBar::tab:bottom:hover {
  background: rgb(40.8, 40.8, 40.8);
}
QTabBar::tab:bottom:selected {
  background: rgb(40.8, 40.8, 40.8);
  border-top-color: rgb(40.8, 40.8, 40.8);
  margin-top: -1px;
}
QTabBar::tab:bottom {
  border-bottom-left-radius: 3px;
  border-bottom-right-radius: 3px;
  margin-left: -1px;
}
QTabBar::tab:bottom:first {
  margin-left: 5px;
}
QTabBar::tab:bottom:last {
  margin-right: 5px;
}
QTabBar::tab:bottom:!selected {
  bottom: 2px;
  padding-bottom: 2px;
  padding-top: 2px;
}
QTabBar::tab:left {
  position: absolute;
  border: 1px solid rgb(20.4, 20.4, 20.4);
  background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 rgb(34.068, 34.068, 34.068), stop: 1 rgb(34.068, 34.068, 34.068));
  padding: 6px 3px;
}
QTabBar::tab:left:hover {
  background: rgb(40.8, 40.8, 40.8);
}
QTabBar::tab:left:selected {
  background: rgb(40.8, 40.8, 40.8);
  border-right-color: rgb(40.8, 40.8, 40.8);
  margin-right: -1px;
}
QTabBar::tab:left {
  border-top-left-radius: 3px;
  border-bottom-left-radius: 3px;
  margin-top: -1px;
}
QTabBar::tab:left:first {
  margin-top: 5px;
}
QTabBar::tab:left:last {
  margin-bottom: 5px;
}
QTabBar::tab:left:!selected {
  left: 2px;
  padding-left: 2px;
  padding-right: 2px;
}
QTabBar::tab:right {
  position: absolute;
  border: 1px solid rgb(20.4, 20.4, 20.4);
  background: qlineargradient(x1: 1, y1: 0, x2: 0, y2: 0, stop: 0 rgb(34.068, 34.068, 34.068), stop: 1 rgb(34.068, 34.068, 34.068));
  padding: 6px 3px;
}
QTabBar::tab:right:hover {
  background: rgb(40.8, 40.8, 40.8);
}
QTabBar::tab:right:selected {
  background: rgb(40.8, 40.8, 40.8);
  border-left-color: rgb(40.8, 40.8, 40.8);
  margin-left: -1px;
}
QTabBar::tab:right {
  border-top-right-radius: 3px;
  border-bottom-right-radius: 3px;
  margin-top: -1px;
}
QTabBar::tab:right:first {
  margin-top: 5px;
}
QTabBar::tab:right:last {
  margin-bottom: 5px;
}
QTabBar::tab:right:!selected {
  right: 2px;
  padding-right: 2px;
  padding-left: 2px;
}

QTabWidget::pane {
  background: transparent;
  border: none;
  border-top: 1px solid rgb(20.4, 20.4, 20.4);
  padding: 5px;
}
QTabWidget::pane[tabPosition=North] {
  margin-top: -1px;
}
QTabWidget::pane[tabPosition=South] {
  margin-bottom: -1px;
}
QTabWidget::pane[tabPosition=West] {
  margin-left: -1px;
}
QTabWidget::pane[tabPosition=East] {
  margin-right: -1px;
}

QDockWidget {
  background: transparent;
  font-weight: bold;
}
QDockWidget::close-button, QDockWidget::float-button {
  border: none;
  border-radius: 2px;
  padding: 0;
  icon-size: 16px 16px;
  min-width: 16px;
  max-width: 16px;
  min-height: 16px;
  max-height: 16px;
  right: 5px;
}
QDockWidget::close-button:hover, QDockWidget::float-button:hover {
  background: rgb(71.4, 71.4, 71.4);
}
QDockWidget::close-button:pressed, QDockWidget::float-button:pressed {
  background: rgb(61.2, 61.2, 61.2);
}
QDockWidget::float-button:closable {
  right: 24px;
}
QDockWidget::title {
  background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 rgb(40.8, 40.8, 40.8), stop: 1 rgb(30.6, 30.6, 30.6));
  border-top-left-radius: 3px;
  border-top-right-radius: 3px;
  padding: 5px;
  text-align: left;
  border-bottom: 1px solid transparent;
  margin-bottom: -1px;
}
QDockWidget > QWidget {
  background: rgb(40.8, 40.8, 40.8);
  border-bottom-left-radius: 3px;
  border-bottom-right-radius: 3px;
}
QDockWidget > QCefWidget {
  padding: 1px;
}
QDockWidget {
  border: 1px solid transparent;
  border-bottom: 1.5px solid rgb(40.8, 40.8, 40.8);
  border-bottom-left-radius: 6px;
  border-bottom-right-radius: 6px;
  margin-bottom: -1px;
}
QDockWidget::window {
  margin-bottom: 0;
  background: transparent;
  border: 1.5px solid rgb(103.4, 49.4, 20.9);
  border-radius: 4px;
}
QDockWidget::window:active {
  border-color: #A63A01;
}

OBSDock {
  qproperty-dropShadow: true;
}

QMainWindow {
  background: rgb(20.4, 20.4, 20.4);
}
QMainWindow::separator {
  width: 5px;
  background: transparent;
}
QMainWindow::separator:hover {
  background: #A63A01;
}
QMainWindow > QTabBar {
  font-size: var(--fontSizeSmallest);
  qproperty-expanding: 1;
}
QMainWindow > QTabBar::tab:top {
  position: absolute;
  border: 1px solid rgb(40.8, 40.8, 40.8);
  background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 rgb(20.4, 20.4, 20.4), stop: 1 rgb(30.6, 30.6, 30.6));
  padding: 3px 6px;
  border-bottom: none;
}
QMainWindow > QTabBar::tab:top:hover {
  background: rgb(30.6, 30.6, 30.6);
}
QMainWindow > QTabBar::tab:top:selected {
  background: rgb(40.8, 40.8, 40.8);
}
QMainWindow > QTabBar::tab:top {
  border-top-left-radius: 3px;
  border-top-right-radius: 3px;
  margin-left: -1px;
}
QMainWindow > QTabBar::tab:top:first {
  margin-left: 5px;
}
QMainWindow > QTabBar::tab:top:last {
  margin-right: 5px;
}
QMainWindow > QTabBar::tab:top:!selected {
  top: 2px;
  padding-top: 2px;
  padding-bottom: 2px;
}
QMainWindow > QTabBar::tab:bottom {
  position: absolute;
  border: 1px solid rgb(40.8, 40.8, 40.8);
  background: qlineargradient(x1: 0, y1: 1, x2: 0, y2: 0, stop: 0 rgb(20.4, 20.4, 20.4), stop: 1 rgb(30.6, 30.6, 30.6));
  padding: 3px 6px;
  border-top: none;
}
QMainWindow > QTabBar::tab:bottom:hover {
  background: rgb(30.6, 30.6, 30.6);
}
QMainWindow > QTabBar::tab:bottom:selected {
  background: rgb(40.8, 40.8, 40.8);
}
QMainWindow > QTabBar::tab:bottom {
  border-bottom-left-radius: 3px;
  border-bottom-right-radius: 3px;
  margin-left: -1px;
}
QMainWindow > QTabBar::tab:bottom:first {
  margin-left: 5px;
}
QMainWindow > QTabBar::tab:bottom:last {
  margin-right: 5px;
}
QMainWindow > QTabBar::tab:bottom:!selected {
  bottom: 2px;
  padding-bottom: 2px;
  padding-top: 2px;
}
QMainWindow > QTabBar::tab:left {
  position: absolute;
  border: 1px solid rgb(40.8, 40.8, 40.8);
  background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 rgb(20.4, 20.4, 20.4), stop: 1 rgb(30.6, 30.6, 30.6));
  padding: 6px 3px;
  border-right: none;
}
QMainWindow > QTabBar::tab:left:hover {
  background: rgb(30.6, 30.6, 30.6);
}
QMainWindow > QTabBar::tab:left:selected {
  background: rgb(40.8, 40.8, 40.8);
}
QMainWindow > QTabBar::tab:left {
  border-top-left-radius: 3px;
  border-bottom-left-radius: 3px;
  margin-top: -1px;
}
QMainWindow > QTabBar::tab:left:first {
  margin-top: 5px;
}
QMainWindow > QTabBar::tab:left:last {
  margin-bottom: 5px;
}
QMainWindow > QTabBar::tab:left:!selected {
  left: 2px;
  padding-left: 2px;
  padding-right: 2px;
}
QMainWindow > QTabBar::tab:right {
  position: absolute;
  border: 1px solid rgb(40.8, 40.8, 40.8);
  background: qlineargradient(x1: 1, y1: 0, x2: 0, y2: 0, stop: 0 rgb(20.4, 20.4, 20.4), stop: 1 rgb(30.6, 30.6, 30.6));
  padding: 6px 3px;
  border-left: none;
}
QMainWindow > QTabBar::tab:right:hover {
  background: rgb(30.6, 30.6, 30.6);
}
QMainWindow > QTabBar::tab:right:selected {
  background: rgb(40.8, 40.8, 40.8);
}
QMainWindow > QTabBar::tab:right {
  border-top-right-radius: 3px;
  border-bottom-right-radius: 3px;
  margin-top: -1px;
}
QMainWindow > QTabBar::tab:right:first {
  margin-top: 5px;
}
QMainWindow > QTabBar::tab:right:last {
  margin-bottom: 5px;
}
QMainWindow > QTabBar::tab:right:!selected {
  right: 2px;
  padding-right: 2px;
  padding-left: 2px;
}

QDialogButtonBox {
  dialogbuttonbox-buttons-have-icons: 0;
}

QGroupBox {
  border: none;
  border-radius: 3px;
  font-size: var(--fontSizeLarge);
  font-weight: bold;
  padding: 5px;
  padding-top: 1.25em;
}

QListView {
  background: rgb(34.068, 34.068, 34.068);
  border: 1px solid rgb(20.4, 20.4, 20.4);
  border-radius: 3px;
  qproperty-spacing: 0;
}

QMenuBar {
  background: transparent;
  padding: 1px 0;
}
QMenuBar::item {
  border-radius: 3px;
  padding: 1px 3px;
}
QMenuBar::item:selected {
  background: rgb(71.4, 71.4, 71.4);
}

QSizeGrip {
  max-width: 0px;
  max-height: 0px;
}

QSlider::groove {
  background: transparent;
}
QSlider::groove:horizontal {
  height: 4px;
}
QSlider::groove:vertical {
  width: 4px;
}
QSlider::add-page, QSlider::sub-page {
  background: rgb(30.6, 30.6, 30.6);
  border-radius: 2px;
}
QSlider::add-page:disabled, QSlider::sub-page:disabled {
  background: rgba(30.6, 30.6, 30.6, 0.5);
}
QSlider::add-page:vertical, QSlider::sub-page:horizontal {
  background: #A63A01;
}
QSlider::add-page:vertical:disabled, QSlider::sub-page:horizontal:disabled {
  background: rgba(166, 58, 1, 127);
}
QSlider::handle {
  background: rgb(198.4, 198.4, 198.4);
  border: 1px solid rgb(20.4, 20.4, 20.4);
  border-radius: 5px;
}
QSlider::handle:horizontal {
  margin: -3px 0px;
  width: 18px;
}
QSlider::handle:vertical {
  margin: 0px -3px;
  height: 18px;
}
QSlider::handle:hover {
  background: rgb(223.2, 223.2, 223.2);
}
QSlider::handle:disabled {
  background: rgb(99.2, 99.2, 99.2);
  border-color: rgba(20.4, 20.4, 20.4, 0.5);
}

QSplitter::handle {
  background: rgb(34.068, 34.068, 34.068);
  border: none;
}
QSplitter::handle:horizontal {
  width: 5px;
}
QSplitter::handle:vertical {
  height: 5px;
}
QSplitter::handle:hover {
  background: #A63A01;
}

QToolBar {
  padding: 3px;
}
QToolBar::separator {
  border: none;
  padding: 3px;
}

QToolTip {
  background: rgb(34.068, 34.068, 34.068);
  border: 1px solid rgb(20.4, 20.4, 20.4);
  border-radius: 3px;
}

QMenu {
  background: rgb(34.068, 34.068, 34.068);
  border: 1px solid rgb(20.4, 20.4, 20.4);
  border-radius: 3px;
  icon-size: 16px;
}
QMenu::item {
  border-radius: 2px;
  height: 1.5em;
  margin: 0;
  padding: 0 5px;
}
QMenu::item:selected {
  background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 rgb(217.1419161677, 75.8688622754, 1.3080838323), stop: 0.5 #A63A01);
}
QMenu::icon {
  position: relative;
  left: 5px;
}
QMenu::indicator {
  margin-left: 7px;
  margin-right: 1px;
  width: 12px;
  height: 12px;
}
QMenu::indicator:exclusive {
  image: url(theme:Fusion/ui/radio/unchecked.svg);
}
QMenu::indicator:exclusive:checked {
  image: url(theme:Fusion/ui/radio/checked.svg);
}
QMenu::indicator:exclusive:hover:!pressed {
  image: url(theme:Fusion/ui/radio/hover.svg);
}
QMenu::indicator:exclusive:hover:!pressed:checked {
  image: url(theme:Fusion/ui/radio/checked hover.svg);
}
QMenu::indicator:exclusive:disabled {
  image: url(theme:Fusion/ui/radio/disabled.svg);
}
QMenu::indicator:exclusive:disabled:checked {
  image: url(theme:Fusion/ui/radio/checked disabled.svg);
}
QMenu::indicator:non-exclusive {
  image: url(theme:Fusion/ui/checkbox/unchecked.svg);
}
QMenu::indicator:non-exclusive:checked {
  image: url(theme:Fusion/ui/checkbox/checked.svg);
}
QMenu::indicator:non-exclusive:hover:!pressed {
  image: url(theme:Fusion/ui/checkbox/hover.svg);
}
QMenu::indicator:non-exclusive:hover:!pressed:checked {
  image: url(theme:Fusion/ui/checkbox/checked hover.svg);
}
QMenu::indicator:non-exclusive:disabled {
  image: url(theme:Fusion/ui/checkbox/disabled.svg);
}
QMenu::indicator:non-exclusive:disabled:checked {
  image: url(theme:Fusion/ui/checkbox/checked disabled.svg);
}
QMenu::separator {
  background: rgb(20.4, 20.4, 20.4);
  height: 1px;
}

.checkbox-icon {
  spacing: 0;
}

AbsoluteSlider {
  qproperty-tickColor: rgba(248, 248, 248, 63);
}

OBSQTDisplay {
  qproperty-displayBackgroundColor: black;
}

VisibilityItemWidget QCheckBox {
  margin-left: 5px;
}
VisibilityItemWidget OBSSourceLabel {

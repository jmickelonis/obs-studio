}
OBSBasic #previewZoomInButton {
  margin-right: 3px;
}
OBSBasic #previewScalingMode {
  font-size: var(--fontSizeSmall);
  padding-top: 0;
  padding-bottom: 0;
  height: 16px;
}
OBSBasic #previewScalingMode:!hover {
  background: none;
  border-color: transparent;
}
OBSBasic #previewXScrollBar {
  margin-top: 1px;
  height: 7px;
}
OBSBasic #previewYScrollBar {
  margin-left: 1px;
  width: 7px;
}

StatusBarWidget > QFrame {
  margin-left: 0.5em;
  margin-bottom: 1px;
  min-height: 1.25em;
}
StatusBarWidget #kbps,
StatusBarWidget #recordTime,
StatusBarWidget #streamTime {
  margin-left: 0.15em;
}

OBSBasicSettings > QAbstractItemView {
  font-weight: bold;
  qproperty-iconSize: 20px 20px;
}
OBSBasicSettings > QAbstractItemView::item {
  font-weight: bold;
  height: 1.66em;
}
OBSBasicSettings QTabWidget::pane {
  padding: 0;
}
OBSBasicSettings OBSSourceLabel {
  font-weight: bold;
}
OBSBasicSettings #hotkeyPage OBSSourceLabel {

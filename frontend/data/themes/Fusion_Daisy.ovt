}

OBSHotkeyWidget QPushButton {
  margin-left: 3px;
}
OBSHotkeyWidget .icon-revert {
  margin-left: 5px;
}

SceneTree,
SourceTree {
  background: transparent;
  border: none;
}

SceneTree {
  qproperty-gridItemWidth: 150;
  qproperty-gridItemHeight: 24;
}
SceneTree::item:selected:!active:!hover {
  background: #A63A01;
}
SceneTree[viewMode=IconMode] {
  font-size: var(--fontSizeSmall);
  padding: 1px;
}
SceneTree[viewMode=IconMode]::item {
  margin: 1px;
}

SourceTreeItem {
  padding-left: 2px;
